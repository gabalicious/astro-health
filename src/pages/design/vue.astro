---
import DesignGallery from '@/components/vue/DesignGallery.vue';
import Layout from '@/layouts/Layout.astro';
---

<Layout title="Design system · Vue" framework="vue">
  <main class="mx-auto flex min-h-screen w-full max-w-3xl flex-col items-center gap-6 px-6 py-12">
    <header class="w-full">
      <h1 class="text-2xl font-semibold tracking-tight">Vue implementation</h1>
      <p class="text-sm text-muted-foreground">
        Every token, primitive and field kind the app is built from — flip to Svelte to compare
        kits.
      </p>
    </header>
    <DesignGallery client:load />
  </main>
</Layout>
