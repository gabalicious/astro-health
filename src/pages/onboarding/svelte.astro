---
import OnboardingWizard from '@/components/svelte/OnboardingWizard.svelte';
import Layout from '@/layouts/Layout.astro';
---

<Layout title="Set up your plan · Svelte" framework="svelte">
  <main class="mx-auto flex min-h-screen w-full max-w-3xl flex-col items-center gap-6 px-6 py-12">
    <header class="w-full max-w-xl">
      <h1 class="text-2xl font-semibold tracking-tight">Svelte implementation</h1>
      <p class="text-sm text-muted-foreground">Step two of two: tell us about your goals.</p>
    </header>
    <OnboardingWizard client:load />
  </main>
</Layout>
