---
import OnboardingWizard from '@/components/vue/OnboardingWizard.vue';
import Layout from '@/layouts/Layout.astro';
---

<Layout title="Set up your plan · Vue">
  <main class="mx-auto flex min-h-screen w-full max-w-3xl flex-col items-center gap-6 px-6 py-16">
    <header class="w-full max-w-xl">
      <a href="/" class="text-sm text-muted-foreground hover:text-foreground">← Both versions</a>
      <h1 class="mt-2 text-2xl font-semibold tracking-tight">Vue implementation</h1>
      <p class="text-sm text-muted-foreground">Step two of two: tell us about your goals.</p>
    </header>
    <OnboardingWizard client:load />
  </main>
</Layout>
