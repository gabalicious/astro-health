---
import LoginForm from '@/components/svelte/LoginForm.svelte';
import Layout from '@/layouts/Layout.astro';
---

<Layout title="Log in · Svelte">
  <main class="mx-auto flex min-h-screen w-full max-w-3xl flex-col items-center gap-6 px-6 py-16">
    <header class="w-full max-w-xl">
      <a href="/" class="text-sm text-muted-foreground hover:text-foreground">← Both versions</a>
      <h1 class="mt-2 text-2xl font-semibold tracking-tight">Svelte implementation</h1>
      <p class="text-sm text-muted-foreground">
        Log back in, or <a href="/signup/svelte" class="text-primary hover:underline">create an account</a>.
      </p>
    </header>
    <LoginForm onboardingHref="/onboarding/svelte" settingsHref="/settings/svelte" client:load />
  </main>
</Layout>
