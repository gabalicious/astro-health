---
import LoginForm from '@/components/vue/LoginForm.vue';
import Layout from '@/layouts/Layout.astro';
---

<Layout title="Log in · Vue">
  <main class="mx-auto flex min-h-screen w-full max-w-3xl flex-col items-center gap-6 px-6 py-16">
    <header class="w-full max-w-xl">
      <a href="/" class="text-sm text-muted-foreground hover:text-foreground">← Both versions</a>
      <h1 class="mt-2 text-2xl font-semibold tracking-tight">Vue implementation</h1>
      <p class="text-sm text-muted-foreground">
        Log back in, or <a href="/signup/vue" class="text-primary hover:underline">create an account</a>.
      </p>
    </header>
    <LoginForm onboardingHref="/onboarding/vue" settingsHref="/settings/vue" client:load />
  </main>
</Layout>
