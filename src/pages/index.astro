---
import Layout from '@/layouts/Layout.astro';

const SCREENS = [
  {
    segment: 'signup',
    label: 'Create account',
    blurb: 'Email and password. A single-step config through the same engine.',
  },
  {
    segment: 'onboarding',
    label: 'Onboarding',
    blurb: 'Goal, body stats in either unit system, activity — then your daily plan.',
  },
  {
    segment: 'workouts',
    label: 'Log a workout',
    blurb: 'Repeated field groups: every set is a row in one array field.',
  },
  {
    segment: 'settings',
    label: 'Settings',
    blurb: 'The onboarding config again, flat and prefilled. Needs an account.',
  },
  {
    segment: 'login',
    label: 'Log in',
    blurb: 'Form-level errors, and a checkbox that stretches the session.',
  },
  {
    segment: 'design',
    label: 'Design system',
    blurb: 'Tokens, primitives and every field kind — one gallery rendered by both UI kits.',
  },
];
---

<Layout title="Astro Health">
  <main class="mx-auto flex min-h-screen w-full max-w-3xl flex-col justify-center gap-10 px-6 py-16">
    <div class="grid gap-3">
      <h1 class="text-3xl font-semibold tracking-tight">Astro Health</h1>
      <p class="max-w-prose text-muted-foreground">
        Every screen is described once as schema-driven config and rendered twice. The Vue and
        Svelte versions share the same Zod schemas, field definitions and Hono endpoints, so the
        only thing that differs between them is the rendering layer.
      </p>
      <p class="max-w-prose text-sm text-muted-foreground">
        Start with <a href="/signup/vue" class="text-primary hover:underline">Vue</a> or
        <a href="/signup/svelte" class="text-primary hover:underline">Svelte</a>. Once you are in,
        every page has a nav — including a link to the same screen in the other stack.
      </p>
    </div>

    <div class="grid gap-3">
      {
        SCREENS.map((screen) => (
          <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1 rounded-xl border bg-card p-5 shadow-sm">
            <span class="text-base font-medium">{screen.label}</span>
            <span class="flex-1 text-sm text-muted-foreground">{screen.blurb}</span>
            <span class="flex gap-3 text-sm">
              <a href={`/${screen.segment}/vue`} class="text-primary hover:underline">
                Vue
              </a>
              <a href={`/${screen.segment}/svelte`} class="text-primary hover:underline">
                Svelte
              </a>
            </span>
          </div>
        ))
      }
    </div>
  </main>
</Layout>
