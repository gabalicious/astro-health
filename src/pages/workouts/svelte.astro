---
import WorkoutLogger from '@/components/svelte/WorkoutLogger.svelte';
import Layout from '@/layouts/Layout.astro';
---

<Layout title="Log a workout · Svelte">
  <main class="mx-auto flex min-h-screen w-full max-w-3xl flex-col items-center gap-6 px-6 py-16">
    <header class="w-full max-w-xl">
      <a href="/" class="text-sm text-muted-foreground hover:text-foreground">← Both versions</a>
      <h1 class="mt-2 text-2xl font-semibold tracking-tight">Svelte implementation</h1>
      <p class="text-sm text-muted-foreground">
        Repeated field groups — every set is a row in one array field.
      </p>
    </header>
    <WorkoutLogger loginHref="/login/svelte" workoutsHref="/workouts/svelte" client:load />
  </main>
</Layout>
