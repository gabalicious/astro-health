---
import WorkoutLogger from '@/components/vue/WorkoutLogger.vue';
import Layout from '@/layouts/Layout.astro';
---

<Layout title="Log a workout · Vue" framework="vue">
  <main class="mx-auto flex min-h-screen w-full max-w-3xl flex-col items-center gap-6 px-6 py-12">
    <header class="w-full max-w-xl">
      <h1 class="text-2xl font-semibold tracking-tight">Vue implementation</h1>
      <p class="text-sm text-muted-foreground">
        Repeated field groups — every set is a row in one array field.
      </p>
    </header>
    <WorkoutLogger loginHref="/login/vue" workoutsHref="/workouts/vue" client:load />
  </main>
</Layout>
