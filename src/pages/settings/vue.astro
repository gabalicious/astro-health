---
import SettingsForm from '@/components/vue/SettingsForm.vue';
import Layout from '@/layouts/Layout.astro';
---

<Layout title="Your settings · Vue" framework="vue">
  <main class="mx-auto flex min-h-screen w-full max-w-3xl flex-col items-center gap-6 px-6 py-12">
    <header class="w-full max-w-xl">
      <h1 class="text-2xl font-semibold tracking-tight">Vue implementation</h1>
      <p class="text-sm text-muted-foreground">
        Adjust your answers — your plan recalculates when you save.
      </p>
    </header>
    <SettingsForm
      loginHref="/login/vue"
      onboardingHref="/onboarding/vue"
      settingsHref="/settings/vue"
      client:load
    />
  </main>
</Layout>
